# Dependencies. This app keeps its own node_modules on purpose -- it lives
# outside the root package.json's workspaces so that Metro resolves one flat
# tree rather than a hoisted one. See mobile/README.md.
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated by `expo prebuild`. Not committed: it is derived from app.json,
# app.config.js and plugins/, and regenerating it is `npm run prebuild`.
# Committing it would mean every config change had to be made in two places,
# and the second one would be the one that was forgotten.
android/
ios/

# Built APKs and the manifest beside them. Rebuilt from source by `npm run apk`.
release/

# Never. The release keystore is the one secret here that cannot be rotated:
# lose it or leak it and every installed copy is stranded on its current
# version, because Android will not accept an update signed with another key.
# It belongs in a backup somewhere off this machine, not in git.
*.keystore
*.jks

# Local Expo/EAS state
.easignore

# Logs
npm-debug.*
*.log
