# Real PostgreSQL service (winget install PostgreSQL.PostgreSQL.17).
#
# chat_dev, because this file is the template for a *development checkout* and
# an installed server on the same box owns `chat`. The two used to be one
# database, and the failure was never a crash -- it was a migration, a
# `prisma db push` or a seed landing on the data ten people were using.
#
# One-time setup:
#   psql -U postgres -v db_name=chat_dev -f prisma/setup-postgres.sql
#   npx prisma db push
#
# The installer does not read this file. It writes its own .env pointing at
# `chat`, with a password generated per install, so nothing here affects one.
DATABASE_URL="postgres://chat_app:chat_app_local_dev_pw@localhost:5432/chat_dev?schema=public"

# Any long random string. Regenerate for the real deployment.
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000

# The address the desktop client is told to reach LiveKit on. In production this
# is ws://<your-public-ip>:7880 — never bake it into the shipped client.
# Must match the `keys:` block in infra/livekit/livekit.yaml — the server signs
# join tokens with this pair and LiveKit verifies the signature. The secret has
# to be at least 32 characters. Never "devkey"/"secret": that pair is published
# in LiveKit's own repository.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="APIchangeme"
LIVEKIT_API_SECRET="change-me-32-characters-or-longer-please"

MAX_UPLOAD_BYTES=26214400

# Where uploaded images and published client builds live. Both default to the
# repo layout (cwd/../../data/...), which is right for a checkout and wrong for
# an installed server; the installer writes both explicitly.
# UPLOAD_DIR="C:/isthislegit/data/uploads"
# UPDATES_DIR="C:/isthislegit/data/updates"

# A version floor for the desktop client. Leave unset. Setting it stops every
# older client connecting, which is worse than the skew it avoids -- it is for
# a change that genuinely cannot be made compatible, and nothing else.
# MIN_CLIENT_VERSION=0.3.0

# Voice audio quality, for everyone on this server. One of:
#   voice     24 kbps mono, DTX on   - for a bad or metered connection
#   balanced  48 kbps mono, RED on   - the default; what most calls want
#   high      96 kbps mono, RED on   - noticeably better, still echo-cancelled
#   studio   128 kbps stereo         - headphones only: stereo means Chromium
#                                      will not echo-cancel, so speakers feed back
# Applies on each person's next join. Restart the server after changing it.
VOICE_QUALITY="studio"


# Which origins may call this API and the socket, comma or space separated.
# Unset means the clients this repo ships: "null" (a packaged desktop client
# renders from file://, which Chromium sends as the literal origin "null") and
# the electron-vite dev renderer on :5173. A request with no Origin header at
# all is always allowed -- that is the console, curl and every health probe,
# and a browser always sends one when it matters. Add this server's own web
# origin here if anything ever loads it in a browser tab.
# CORS_ORIGINS="null,https://isthislegit.duckdns.org"

# Failed sign-in attempts allowed per IP address, and the window they are
# remembered for. Applies to /api/login, /api/register and the raw Better Auth
# credential endpoints together, so using one instead of the other gains
# nothing. A successful sign-in clears the address, so this never locks out
# somebody whose client is merely reconnecting.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_MS=300000
