# Real PostgreSQL service (winget install PostgreSQL.PostgreSQL.17).
# One-time role/db setup: psql -U postgres -f prisma/setup-postgres.sql
DATABASE_URL="postgres://chat_app:chat_app_local_dev_pw@localhost:5432/chat?schema=public"

# Any long random string. Regenerate for the real deployment.
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

PORT=3000

# The address the desktop client is told to reach LiveKit on. In production this
# is ws://<your-public-ip>:7880 — never bake it into the shipped client.
# Must match the `keys:` block in infra/livekit/livekit.yaml — the server signs
# join tokens with this pair and LiveKit verifies the signature. The secret has
# to be at least 32 characters. Never "devkey"/"secret": that pair is published
# in LiveKit's own repository.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="APIchangeme"
LIVEKIT_API_SECRET="change-me-32-characters-or-longer-please"

MAX_UPLOAD_BYTES=26214400

# Where uploaded images and published client builds live. Both default to the
# repo layout (cwd/../../data/...), which is right for a checkout and wrong for
# an installed server; the installer writes both explicitly.
# UPLOAD_DIR="C:/isthislegit/data/uploads"
# UPDATES_DIR="C:/isthislegit/data/updates"

# A version floor for the desktop client. Leave unset. Setting it stops every
# older client connecting, which is worse than the skew it avoids -- it is for
# a change that genuinely cannot be made compatible, and nothing else.
# MIN_CLIENT_VERSION=0.3.0

# Voice audio quality, for everyone on this server. One of:
#   voice     24 kbps mono, DTX on   - for a bad or metered connection
#   balanced  48 kbps mono, RED on   - the default; what most calls want
#   high      96 kbps mono, RED on   - noticeably better, still echo-cancelled
#   studio   128 kbps stereo         - headphones only: stereo means Chromium
#                                      will not echo-cancel, so speakers feed back
# Applies on each person's next join. Restart the server after changing it.
VOICE_QUALITY="studio"

