generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Better Auth
// These four models are Better Auth's required shape. It owns them; we only
// read from User. Verify against `npx @better-auth/cli generate` after changing
// Better Auth's version or plugins.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // username plugin
  username        String? @unique
  displayUsername String?

  sessions    Session[]
  accounts    Account[]
  memberships GuildMember[]
  messages    Message[]
  readStates  ChannelReadState[]
  invitesMade InviteCode[]       @relation("InviteCreator")
  attachments Attachment[]
  bans        GuildBan[]         @relation("BannedUser")
  bansIssued  GuildBan[]         @relation("BanIssuer")
  mentions    MessageMention[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  // Nullable on purpose. Better Auth only has an issuer for providers that
  // have one -- an OIDC or SSO account. A credential account, which is all
  // this deployment creates, has none, and 1.7.3 stopped sending the field at
  // all rather than sending an empty string. Required, that turned every
  // registration into a Prisma validation error at the point the account row
  // was written, after the user row already existed.
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ------------------------------------------------------------------- App

enum ChannelKind {
  TEXT
  VOICE
}

enum MemberRole {
  ADMIN
  MEMBER
}

model Guild {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  channels Channel[]
  members  GuildMember[]
  invites  InviteCode[]
  bans     GuildBan[]
}

model Channel {
  id        String      @id
  guildId   String
  guild     Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  kind      ChannelKind @default(TEXT)
  position  Int         @default(0)
  createdAt DateTime    @default(now())

  messages   Message[]
  readStates ChannelReadState[]

  @@index([guildId])
}

model GuildMember {
  id       String     @id
  guildId  String
  guild    Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  // A mute is a deadline rather than a flag, so it lifts itself with no timer
  // and no sweeper job. Null means not muted; an indefinite mute is simply a
  // date far enough out that it never arrives.
  //
  // What it takes away is the microphone, and only that: see MuteMemberInput
  // in the shared package. Voice enforces it by permission on the LiveKit
  // participant, which is re-derived from this column on a sweep -- so an
  // expiry gives the microphone back without anything having to be told.
  mutedUntil DateTime?

  // When a connection of theirs was last seen, written by the gateway on
  // connect and on disconnect.
  //
  // Here rather than on User because User is Better Auth's model and we only
  // read from it. The cost is that somebody in two guilds has two copies of
  // one fact -- accepted because both are written by the same single
  // updateMany, so they cannot drift, and because the member list already
  // loads these rows and gets the column for no extra query. Null means an
  // account that has not connected since this was added.
  lastSeenAt DateTime?

  @@unique([guildId, userId])
  @@index([userId])
}

model Message {
  id        String   @id
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  editedAt  DateTime?
  deletedAt DateTime?
  // Who deleted it: null when the author did, a moderator's id otherwise. The
  // row survives either way, so a deletion can still be looked into later.
  deletedById String?

  // Echoed back to the sender so an optimistic copy can be de-duplicated.
  clientNonce String?

  // A pin is two nullable columns on the message rather than a join table,
  // because a message is pinned at most once and the pin has no life of its
  // own: unpinning is not an event anyone wants a record of, and deleting the
  // message must take the pin with it -- which here it does, for free.
  pinnedAt   DateTime?
  // Who pinned it. A plain id, like `deletedById`: it is an audit note read by
  // a person looking into something, not something the app joins on.
  pinnedById String?

  /// What search matches against: `content`, parsed into lexemes by Postgres.
  ///
  /// A column rather than an expression index because it is GENERATED ALWAYS
  /// ... STORED -- Postgres recomputes it on every insert and every edit, so
  /// it cannot drift from the text the way anything we maintained ourselves
  /// eventually would. Nothing in this codebase ever writes it; Prisma cannot
  /// type a tsvector, so it is Unsupported and invisible to the client.
  ///
  /// The generated-ness is the one thing Prisma does not model. If a future
  /// `prisma migrate dev` offers to alter this column, it is wrong -- the
  /// definition lives in 20260908150000_search_and_ephemeral_files.
  searchVector Unsupported("tsvector")?

  attachments Attachment[]
  mentions    MessageMention[]

  // Ids are UUIDv7, so id order is chronological order: this one index serves
  // the cursor pagination in both directions.
  @@index([channelId, id])
  // What makes search a lookup rather than a scan of every message ever sent.
  @@index([searchVector], type: Gin)
  // "The pins in this channel" -- asked every time the list is opened, and
  // otherwise a scan of every message the channel has ever held.
  @@index([channelId, pinnedAt])
}

/**
 * One person tagged in one message.
 *
 * The markers are already in `Message.content`, so this table stores nothing
 * that could not be recovered by reading every message ever sent -- which is
 * the point. "How many unread tags do I have in each channel" is asked on
 * every launch and every read, and against the text it is a full scan with a
 * LIKE in it. Here it is one index.
 *
 * `channelId` is copied down from the message for the same reason: the query
 * is per channel, and joining Message to get there would undo the index.
 * Messages never move between channels, so the copy cannot go stale.
 */
model MessageMention {
  id        String  @id
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String

  // Tagging someone twice in one message is one tag; the unique constraint is
  // what makes re-resolving an edit safe to run as a delete and a re-insert.
  @@unique([messageId, userId])
  // Ids are UUIDv7, so "unread" is `messageId > lastReadMessageId` and this
  // index answers it without touching Message at all.
  @@index([userId, channelId, messageId])
}

model Attachment {
  id          String   @id
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName    String
  storedName  String
  contentType String
  size        Int
  // Kept so the message list can reserve space and not jump while images load.
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  // When the bytes go. Null means kept indefinitely, which is every picture
  // and every row written before this column existed -- so the migration
  // back-fills nothing and an upgrade changes nothing about what is stored.
  //
  // Everything that is not a picture gets a deadline at upload time. That is
  // the deal the uploader is shown and it is why arbitrary files are accepted
  // at all: the server is a courier for them, not the place they live.
  expiresAt   DateTime?
  // Stamped when the deadline was acted on. The row outlives the file so the
  // message can still say what was there; deleting it would leave a message
  // that was only a file rendering as a blank gap.
  expiredAt   DateTime?

  @@index([messageId])
  // "What is due to expire" -- asked every hour by the sweeper, and otherwise
  // a scan of every attachment ever uploaded.
  @@index([expiresAt])
}

model ChannelReadState {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId         String
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  @@unique([userId, channelId])
}

model InviteCode {
  id          String    @id
  code        String    @unique
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([guildId])
}

/**
 * A ban is a row that outlives the membership it removed, which is the whole
 * point: kicking deletes the GuildMember and nothing remembers, banning
 * deletes it and leaves a record that blocks the way back in.
 */
model GuildBan {
  id         String   @id
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedById String
  bannedBy   User     @relation("BanIssuer", fields: [bannedById], references: [id], onDelete: Cascade)
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([guildId, userId])
  @@index([userId])
}

/**
 * Server-wide policy that somebody edits from the console, keyed by name with
 * a JSON body.
 *
 * Deliberately not `.env`. That file holds the secrets, it needs a restart to
 * be reread, and it is one of the three deployment files the Configuration tab
 * keeps in agreement with each other -- none of which is true of a retention
 * policy adjusted at eleven at night. In a table it is editable live and it is
 * already inside the database backup.
 */
model ServerSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
