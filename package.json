{
  "name": "isthislegit",
  "private": true,
  "version": "0.3.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @isthislegit/server",
    "build": "npm run build --workspace @isthislegit/shared && npm run build --workspace @isthislegit/server",
    "db:migrate": "npm run db:migrate --workspace @isthislegit/server",
    "db:studio": "npm run db:studio --workspace @isthislegit/server",
    "db:generate": "npm run db:generate --workspace @isthislegit/server",
    "console": "npm start --workspace @isthislegit/console",
    "server-app": "npm run dev --workspace @isthislegit/server-app",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
