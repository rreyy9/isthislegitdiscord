# Caddy: TLS termination for the chat server and LiveKit's signalling.
#
# Two hostnames, both pointing at this box, both served on 443 and told apart
# by SNI -- so this is still a single forwarded port. Caddy obtains and renews
# a Let's Encrypt certificate for each on its own.
#
#   isthislegit.duckdns.org      -> chat server   (127.0.0.1:3000)
#   isthislegit-lk.duckdns.org   -> LiveKit       (127.0.0.1:7880)
#
# Start it with infra/caddy/start.ps1.

{
	# 443 only. Caddy would normally also bind 80, for the ACME HTTP-01
	# challenge and an HTTP->HTTPS redirect. Neither is worth a forwarded
	# port here: the client is a desktop app with a server-address field,
	# not a browser someone types a bare hostname into, so there is nothing
	# to redirect -- and the challenge has an alternative that runs entirely
	# on 443 (disable_http_challenge, below).
	#
	# Caddy may still open a local listener on 80. That is harmless as long
	# as 80 is not forwarded on the router: nothing outside can reach it.
	auto_https disable_redirects

	# Uncomment with a real address to have Let's Encrypt warn you before a
	# certificate expires. Renewal is automatic, so this is the channel for
	# when it stops being automatic. Caddy works fine without it.
	# email you@example.com
}

# Certificates over TLS-ALPN-01, which Caddy serves on 443 itself, rather than
# HTTP-01, which would need port 80 open.
(tls443) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}

# --------------------------------------------------------------- chat server

isthislegit.duckdns.org {
	import tls443

	# The HTTP API (/api/*) and Socket.IO (/socket.io/*). reverse_proxy
	# performs the WebSocket upgrade and then gets out of the way, so the
	# socket needs no special handling -- but note the client connects with
	# `transports: ['websocket']` and never falls back to long-polling, so
	# if the upgrade breaks the app does not degrade, it simply never
	# connects.
	reverse_proxy 127.0.0.1:3000
}

# ------------------------------------------------------------------- livekit

isthislegit-lk.duckdns.org {
	import tls443

	# Signalling only -- the client SDK opens a WebSocket to /rtc under
	# whatever host it is given, which is why LiveKit gets its own hostname
	# rather than a path on the other one.
	#
	# The actual voice and screen-share media is UDP on 50000-50100 and goes
	# straight to this box. Caddy cannot carry it and does not need to:
	# WebRTC media is already DTLS-SRTP encrypted end to end. So 7881/tcp,
	# 3478/udp and 50000-50100/udp stay forwarded on the router exactly as
	# they are today -- this file replaces the forwards for 3000 and 7880,
	# and nothing else.
	reverse_proxy 127.0.0.1:7880
}
